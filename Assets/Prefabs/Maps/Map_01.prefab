--- !u!114 &3977035432898894514
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7660210352040601502}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fb2384349d64a784fb5907f9bf8cf49e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: CityCourier.Runtime::CityCourier.CourierInteractable
  Kind: 0
  Dialogue:
  - "\uB3C4\uC2DC \uBC30\uB2EC\uC6D0 \uD6C8\uB828\uC5D0 \uC624\uC2E0 \uAC83\uC744
    \uD658\uC601\uD569\uB2C8\uB2E4. \uD30C\uB780 \uD3EC\uD0C8 \uAC00\uAE4C\uC774\uC5D0\uC11C
    E / X\uB97C \uB204\uB974\uBA74 \uAC19\uC740 \uC52C\uC758 \uCF54\uC2A4\uB85C \uC9C4\uC785\uD569\uB2C8\uB2E4.
    \uB2E4\uC2DC E / X\uB97C \uB20C\uB7EC \uB2E4\uC74C \uC548\uB0B4\uB97C \uB4E4\uC73C\uC138\uC694."
  - "WASD / LS \uC774\uB3D9, Space / A \uC810\uD504\uC640 \uBCBD\uC810\uD504, Shift
    / B \uC2AC\uB77C\uC774\uB4DC\uC640 \uACF5\uC911 \uAE09\uAC15\uD558. \uCCAD\uB85D\uC0C9
    \uBCBD \uAC00\uAE4C\uC774\uC5D0\uC11C \uC804\uC9C4\uD558\uBA74 \uBCBD\uC744 \uD0D1\uB2C8\uB2E4."
  - "\uB9C8\uC6B0\uC2A4 / RS\uB85C \uC2DC\uC810\uC744 \uC870\uC808\uD558\uACE0 \uD720
    \uBC84\uD2BC / Y\uB85C \uC774\uB3D9 \uBC29\uD5A5\uC5D0 \uB9DE\uCDA5\uB2C8\uB2E4.
    Ctrl\uC740 \uCC9C\uCC9C\uD788 \uAC77\uAE30\uC785\uB2C8\uB2E4."
  - "\uB178\uB780 \uD3B8\uC9C0 \uB2E4\uC12F \uAC1C\uB97C \uBAA8\uB450 \uBAA8\uC73C\uACE0
    \uC81C\uC5B4\uAE30\uB97C \uC791\uB3D9\uC2DC\uCF1C \uCD08\uB85D \uBAA9\uC801\uC9C0\uB85C
    \uD5A5\uD558\uC138\uC694. \uCD94\uB77D\uD558\uAC70\uB098 \uB808\uC774\uC800\uC5D0
    \uB2FF\uC73C\uBA74 \uCD5C\uADFC \uCCB4\uD06C\uD3EC\uC778\uD2B8\uB85C \uBCF5\uADC0\uD558\uBA70
    \uD3B8\uC9C0\uB294 \uC720\uC9C0\uB429\uB2C8\uB2E4."
  Indicator: {fileID: 7452368569390679637}
  ActivatedMaterial: {fileID: 2100000, guid: 0039ba56d827f9b46b1a596ad026db8d, type: 2}
